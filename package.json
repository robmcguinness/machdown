{
  "name": "machdown",
  "version": "0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "dev": "pnpm --filter @machdown/extension dev",
    "daemon": "pnpm --filter @machdown/daemon start",
    "daemon:pair": "pnpm --filter @machdown/daemon pair",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --type-check",
    "lint:ci": "oxlint --max-warnings 0 --format github",
    "lint:timings": "oxlint --debug timings",
    "typecheck": "tsc -b",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "lefthook run check --no-tty"
  },
  "devDependencies": {
    "@rm3/lefthook-config": "link:../rm3-shared/packages/lefthook-config",
    "@rm3/oxfmt-config": "link:../rm3-shared/packages/oxfmt-config",
    "@rm3/oxlint-config": "link:../rm3-shared/packages/oxlint-config",
    "@rm3/typescript-config": "link:../rm3-shared/packages/typescript-config",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.3.2"
}
