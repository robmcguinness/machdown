{
  "name": "machdown",
  "version": "0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && rm -rf build && vite build && vite build -c ./vite.worker.config.ts && vite build -c ./vite.content.config.ts",
    "build:watch": "pnpm build && vite build --watch --config ./vite.config.ts",
    "lint": "oxlint --max-warnings 0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@mozilla/readability": "^0.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.3",
    "fflate": "^0.8.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.1.0",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "turndown": "^7.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.431",
    "@iconify/tailwind4": "^1.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/chrome": "^0.1.36",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "oxlint-tsgolint": "^0.17.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-static-copy": "^3.1.5"
  }
}
