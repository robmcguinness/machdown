{
  "name": "@machdown/daemon",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "machdownd": "./src/main.ts"
  },
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": "./src/*"
  },
  "scripts": {
    "build": "tsc -b",
    "generate:schema": "node --conditions=source scripts/generate-config-schema.ts",
    "test": "MACHDOWN_QMD_DISABLED=1 MACHDOWN_LOG_LEVEL=silent node --conditions=source --env-file-if-exists=.env --test --test-reporter=dot --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=test-results.log 'src/**/*.test.ts'",
    "start": "node --conditions=source --env-file-if-exists=.env src/main.ts",
    "dev": "node --conditions=source --env-file-if-exists=.env --watch src/main.ts",
    "pair": "node --conditions=source --env-file-if-exists=.env src/main.ts --pair"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@machdown/contract": "workspace:*",
    "@orpc/json-schema": "2.0.0-beta.31",
    "@orpc/openapi": "2.0.0-beta.31",
    "@orpc/server": "2.0.0-beta.31",
    "@orpc/zod": "2.0.0-beta.31",
    "@rm3/env": "link:../../../rm3-shared/packages/env",
    "@tobilu/qmd": "2.8.3",
    "async-cache-dedupe": "^3.4.0",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "lru-cache": "^11.5.2",
    "pino": "^10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@rm3/typescript-config": "link:../../../rm3-shared/packages/typescript-config",
    "@types/node": "^26.5.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
