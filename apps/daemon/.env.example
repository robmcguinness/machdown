# Copy to `apps/daemon/.env` — `pnpm daemon`, `dev`, `pair` and `test` read it
# through `--env-file-if-exists`. An installed `machdownd` does not: it reads
# the real environment.

# Listen port. `--port` overrides it. An unusable value is reported as a config
# issue and falls back to the stored port, so a typo never blocks startup.
# MACHDOWN_PORT=41998

# Repository path, overriding the stored one. `~` is expanded.
# MACHDOWN_REPO=

# pino level: trace, debug, info, warn, error, fatal or silent.
# MACHDOWN_LOG_LEVEL=info

# Colon-separated extra roots the folder picker may list, beyond your home
# directory and the configured repository.
# MACHDOWN_BROWSE_ROOTS=
