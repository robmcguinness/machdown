{
  "$id": "https://machdown.dev/schemas/daemon.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machdown daemon configuration (~/.machdown/daemon.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "extensions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "extensionId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "pairedAt": {
            "type": "string",
            "minLength": 1
          },
          "tokenHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "extensionId",
          "pairedAt",
          "tokenHash"
        ]
      }
    },
    "port": {
      "default": 41998,
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "repoPath": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    }
  }
}
