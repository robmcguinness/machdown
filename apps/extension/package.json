{
  "name": "@machdown/extension",
  "version": "0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && rm -rf build && vite build && vite build -c ./vite.worker.config.ts && vite build -c ./vite.content.config.ts",
    "build:watch": "pnpm build && vite build --watch --config ./vite.config.ts",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@machdown/contract": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "@orpc/client": "2.0.0-beta.31",
    "@orpc/openapi": "2.0.0-beta.31",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dompurify": "^3.4.15",
    "fflate": "^0.8.3",
    "lucide-react": "^1.45.0",
    "marked": "^18.0.12",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@rm3/typescript-config": "link:../../../rm3-shared/packages/typescript-config",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
